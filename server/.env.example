MONGO_URI=mongodb://localhost:27017/votora
PORT=5013
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
# Production: comma-separated Vercel/production frontend URLs (no trailing slash)
# Example: https://votora-client.vercel.app,https://votora-client-jaam.vercel.app
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# Must match VITE_GOOGLE_CLIENT_ID on Vercel (Client ID only — no secret needed)
NODE_ENV=development
